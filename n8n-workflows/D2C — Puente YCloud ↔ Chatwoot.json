    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const b = item.json.body;\n  const to = b.conversation.meta.sender.phone_number;\n  const convId = b.conversation.id;\n  const atts = b.attachments || [];\n  if (!atts.length) {\n    out.push({ json: { to, conversation_id: convId, kind: 'text', text: b.content }, pairedItem: { item: 0 } });\n    continue;\n  }\n  atts.forEach((a, i) => {\n    const kind = a.file_type === 'image' ? 'image'\n               : a.file_type === 'video' ? 'video'\n               : a.file_type === 'audio' ? 'audio'\n               : 'document';\n    let filename = 'archivo';\n    try { filename = decodeURIComponent(String(a.data_url).split('?')[0].split('/').pop()); } catch (e) {}\n    out.push({ json: {\n      to, conversation_id: convId, kind,\n      link: a.data_url,\n      filename,\n      caption: i === 0 ? (b.content || '') : ''\n    }, pairedItem: { item: 0 } });\n  });\n}\nreturn out;"
      },
